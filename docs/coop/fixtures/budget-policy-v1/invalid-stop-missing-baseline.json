{
  "version": "1.0.0",
  "defaults": {
    "routine": { "wall_minutes": 60, "attempts": 1, "reworks": 1 },
    "high_risk": { "wall_minutes": 120, "attempts": 1, "reworks": 2 }
  },
  "overnight": {
    "max_tasks": 10,
    "max_concurrent_workers": 3,
    "end_time_utc": "06:00",
    "network": "blocked",
    "allowed_commands": ["node"],
    "allowed_write_destinations": ["docs/"],
    "preserve_evidence": true
  },
  "prohibited_actions": ["push", "merge", "deploy", "payment", "material_removal"],
  "stop_conditions": [
    "new_approval_required", "secret_encountered", "scope_escape",
    "merge_conflict", "destructive_migration",
    "repeated_failure", "budget_exhausted", "product_architecture_question"
  ]
}
